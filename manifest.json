{
  "manifest_version": 3,
  "name": "Dark Notes",
  "version": "1.0.0",
  "description": "VS Code-like note-taking extension with file system access",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "manifest_version": 3,
  "name": "Dark Notes",
  "version": "1.0.0",
  "description": "VS Code-like note-taking extension with file system access",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_title": "Open Dark Notes"
  },
  "background": {
    "service_worker": "background.js"
  }
}